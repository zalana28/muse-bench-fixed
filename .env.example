# Copy to .env and set a long random value. The server refuses to start
# (and refuses to sign/verify tokens) without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET=change-me-to-a-long-random-secret-min-16-chars
# Optional:
# PORT=3000
# DEBUG=true
